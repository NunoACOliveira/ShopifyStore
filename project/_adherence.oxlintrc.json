{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/catalog/**",
              "components/core/**",
              "components/frame/**",
              "components/overlay/**",
              "components/product/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newshound|Newshound Subhead|Newshound Headline|Newshound Banner))/i]",
        "message": "Font not provided by the design system. Available: Newshound, Newshound Subhead, Newshound Headline, Newshound Banner."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|disabled|block|size|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, disabled, block, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|href|onClick|key|ref|className|style|children)$/]",
        "message": "<CartLabel> doesn't accept that prop. Declared props: count, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|variant|qty|price|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<CartLine> doesn't accept that prop. Declared props: image, name, variant, qty, price, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CartPanelItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|image|name|variant|qty|price|key|ref|className|style|children)$/]",
        "message": "<CartPanelItem> doesn't accept that prop. Declared props: key, image, name, variant, qty, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='EdgeNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:onBack|onNext|backLabel|nextLabel|hideBack|hideNext|key|ref|className|style|children)$/]",
        "message": "<EdgeNav> doesn't accept that prop. Declared props: onBack, onNext, backLabel, nextLabel, hideBack, hideNext."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnterSplash'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|video|label|onEnter|style|key|ref|className|style|children)$/]",
        "message": "<EnterSplash> doesn't accept that prop. Declared props: image, video, label, onEnter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|multiline|rows|id|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, multiline, rows, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hairline'] > JSXAttribute > JSXIdentifier[name!=/^(?:strong|vertical|length|style|key|ref|className|style|children)$/]",
        "message": "<Hairline> doesn't accept that prop. Declared props: strong, vertical, length, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|style|key|ref|className|style|children)$/]",
        "message": "<LangToggle> doesn't accept that prop. Declared props: value, options, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|small|alt|href|onClick|key|ref|className|style|children)$/]",
        "message": "<LogoMark> doesn't accept that prop. Declared props: size, small, alt, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|ratio|height|kind|style|key|ref|className|style|children)$/]",
        "message": "<MediaSlot> doesn't accept that prop. Declared props: label, note, ratio, height, kind, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaSlot'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:photo|film|clip)$/]",
        "message": "<MediaSlot> kind must be one of 'photo' | 'film' | 'clip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObjectGridItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|image|name|price|soldOut|key|ref|className|style|children)$/]",
        "message": "<ObjectGridItem> doesn't accept that prop. Declared props: id, image, name, price, soldOut."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObjectTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|price|soldOut|onSelect|height|labels|children|style|key|ref|className|style|children)$/]",
        "message": "<ObjectTile> doesn't accept that prop. Declared props: image, name, price, soldOut, onSelect, height, labels, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObjectTile'] > JSXAttribute[name.name='labels'] > Literal[value!=/^(?:hover|always)$/]",
        "message": "<ObjectTile> labels must be one of 'hover' | 'always'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cartCount|active|onNavigate|onCart|onHome|navItems|showNav|showWordmark|showChrome|background|scroll|lang|onLang|style|key|ref|className|style|children)$/]",
        "message": "<PageFrame> doesn't accept that prop. Declared props: children, cartCount, active, onNavigate, onCart, onHome, navItems, showNav, showWordmark, showChrome, background, scroll, lang, onLang, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFrame'] > JSXAttribute[name.name='background'] > Literal[value!=/^(?:plate|flat|none)$/]",
        "message": "<PageFrame> background must be one of 'plate' | 'flat' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|align|style|key|ref|className|style|children)$/]",
        "message": "<PriceLabel> doesn't accept that prop. Declared props: value, label, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<PriceLabel> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCopy'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|measure|style|key|ref|className|style|children)$/]",
        "message": "<ProductCopy> doesn't accept that prop. Declared props: children, align, measure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCopy'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<ProductCopy> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|size|style|key|ref|className|style|children)$/]",
        "message": "<ProductTitle> doesn't accept that prop. Declared props: children, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<ProductTitle> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<SiteNavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SquarePager'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|index|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SquarePager> doesn't accept that prop. Declared props: count, index, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyBuyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|price|disabled|added|onAdd|visible|key|ref|className|style|children)$/]",
        "message": "<StickyBuyBar> doesn't accept that prop. Declared props: name, variant, price, disabled, added, onAdd, visible."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|value|key|ref|className|style|children)$/]",
        "message": "<SwatchOption> doesn't accept that prop. Declared props: id, label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|size|tracking|weight|dimmed|muted|as|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, size, tracking, weight, dimmed, muted, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:a|button)$/]",
        "message": "<TextLink> as must be one of 'a' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|alt|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, alt."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
